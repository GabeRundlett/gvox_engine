{
  "name": "gvox-engine",
  "version": "0.1.0",
  "dependencies": [
    "gvox",
    "fmt",
    "stb",
    "nlohmann-json",
    "minizip",
    "assimp",
    "glm",
    "glfw3",
    {
      "name": "imgui",
      "features": [
        "glfw-binding",
        "docking-experimental"
      ]
    },
    {
      "name": "fsr2",
      "features": [ "vulkan" ]
    }
  ],
  "builtin-baseline": "7d23867a7ea813948a86ac8d76345786e7e6faf2",
  "vcpkg-configuration": {
    "overlay-ports": [
      "./deps/gvox",
      "./cmake/vcpkg-overlay-ports/fsr2",
      "./cmake/vcpkg-overlay-ports/fiber-tasking-lib"
    ]
  }
}
